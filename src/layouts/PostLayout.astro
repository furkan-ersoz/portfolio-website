---
// The layout for every blog post: back link, date + reading time, title, summary,
// the post body and links to the newer / older post.
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../lib/url';
import { formatPostDate, readingMinutes, type Post } from '../lib/blog';
import '../styles/prose.css';

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { data } = post;
---

<BaseLayout title={data.title} description={data.summary}>
  <article class="post">
    <a class="back" href={withBase('/blog')}>← Blog</a>

    <header>
      <p class="meta">
        <time datetime={data.date.toISOString()}>{formatPostDate(data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(post)} min read</span>
        {data.draft && <span class="badge">Draft</span>}
      </p>
      <h1>{data.title}</h1>
      <p class="summary">{data.summary}</p>
      {
        data.updated && (
          <p class="updated muted">
            Updated <time datetime={data.updated.toISOString()}>{formatPostDate(data.updated)}</time>
          </p>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>

  {
    (newer || older) && (
      <nav class="pager" aria-label="More posts">
        {newer && (
          <a class="pager-link" href={withBase(`/blog/${newer.id}`)}>
            <span class="muted">← Newer</span>
            <span>{newer.data.title}</span>
          </a>
        )}
        {older && (
          <a class="pager-link next" href={withBase(`/blog/${older.id}`)}>
            <span class="muted">Older →</span>
            <span>{older.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .back:hover {
    color: var(--text);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .meta .badge {
    text-transform: none;
    letter-spacing: 0;
  }
  h1 {
    font-size: clamp(1.4rem, 4.5vw, 1.8rem);
    letter-spacing: -0.02em;
  }
  .summary {
    margin: 0.75rem 0 0;
    color: var(--text-muted);
  }
  .updated {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .pager-link:hover {
    border-color: var(--border-strong);
    background: var(--surface);
  }
  .pager-link .muted {
    font-size: 0.85rem;
  }
  .pager-link.next {
    text-align: right;
    grid-column: 2;
  }
  @media (max-width: 640px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager-link.next {
      grid-column: auto;
    }
  }
</style>
