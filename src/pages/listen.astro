---
// Listen page. Streaming platforms are set in src/site.config.ts
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcon from '../components/SocialIcon.astro';
import CardList from '../components/CardList.astro';
import { listen } from '../site.config';
import { getSortedMusic, musicToCard } from '../lib/selected';

// Releases from src/content/music/ (none yet → this section stays hidden)
const releases = (await getSortedMusic()).map(musicToCard);

const isTodo = (url: string) => !url || url.trim().toUpperCase().startsWith('TODO');
---

<BaseLayout title="Listen">
  <h1 class="page-title">Listen</h1>
  <p class="intro muted">My music, wherever you listen.</p>

  <ul class="platforms">
    {
      listen.map((p) => (
        <li>
          {isTodo(p.url) ? (
            <span class="platform" aria-disabled="true">
              <SocialIcon name={p.icon} size={28} />
              <span class="name">{p.label}</span>
              <span class="status">Coming soon</span>
            </span>
          ) : (
            <a class="platform" href={p.url} target="_blank" rel="noopener noreferrer">
              <SocialIcon name={p.icon} size={28} />
              <span class="name">{p.label}</span>
              <span class="status">Listen ↗</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>

  {
    releases.length > 0 && (
      <section class="releases" aria-labelledby="releases-title">
        <h2 id="releases-title">Releases</h2>
        <CardList items={releases} />
      </section>
    )
  }
</BaseLayout>

<style>
  .releases {
    margin-top: clamp(2.5rem, 7vw, 4rem);
  }
  .releases h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .intro {
    margin: 0 0 1.5rem;
  }
  .platforms {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .platform {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: 1.1rem 1.1rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }
  a.platform:hover {
    background: var(--surface-hover);
    border-color: var(--text);
  }
  .name {
    font-weight: 600;
  }
  .status {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .platform[aria-disabled='true'] {
    border-style: dashed;
    border-color: var(--border);
    background: transparent;
    color: var(--text-muted);
    cursor: default;
  }
  .platform[aria-disabled='true'] :global(svg) {
    opacity: 0.45;
  }
</style>
