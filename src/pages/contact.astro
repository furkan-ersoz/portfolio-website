---
// Contact page. Email and social links are set in src/site.config.ts
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site, socials } from '../site.config';

const isTodo = (url: string) => !url || url.trim().toUpperCase().startsWith('TODO');
---

<BaseLayout title="Contact">
  <h1 class="page-title">Contact</h1>
  <p class="intro muted">The best way to reach me is by email.</p>

  <a class="email" href={`mailto:${site.email}`}>
    <SocialIcon name="email" />
    {site.email}
  </a>

  <h2 class="elsewhere">Elsewhere</h2>
  <ul class="socials">
    {
      socials.map((s) => (
        <li>
          {isTodo(s.url) ? (
            <span class="button" aria-disabled="true" title="Link coming soon">
              <SocialIcon name={s.icon} />
              {s.label}
            </span>
          ) : (
            <a class="button" href={s.url} target="_blank" rel="noopener noreferrer">
              <SocialIcon name={s.icon} />
              {s.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .intro {
    margin: 0 0 1rem;
  }
  .email {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: clamp(1.05rem, 3.5vw, 1.25rem);
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .elsewhere {
    margin: 2.5rem 0 1rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }
  .socials {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .socials .button {
    width: 100%;
    justify-content: flex-start;
    border-radius: var(--radius);
    padding: 0.8em 1.1em;
  }
</style>
