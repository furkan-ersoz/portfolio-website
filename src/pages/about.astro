---
// About page. The text itself lives in src/content/about/about.md
import { Image, getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const about = await getEntry('about', 'about');
if (!about) throw new Error('Missing src/content/about/about.md');
const { photo, photoWide, photoAlt, en, tr } = about.data;

// Computers get the landscape photo, phones the portrait one.
const wide = photoWide ? await getImage({ src: photoWide, widths: [700, 1240], format: 'webp' }) : null;

// Split the text into paragraphs at empty lines.
const paragraphs = (text: string) =>
  text
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);

const languages = [
  { code: 'en', label: 'EN', name: 'English', ...en },
  { code: 'tr', label: 'TR', name: 'Türkçe', ...tr },
];
---

<BaseLayout title="About">
  <div class="lang-toggle" role="group" aria-label="Language">
    {
      languages.map((lang, i) => (
        <button type="button" data-lang={lang.code} aria-pressed={i === 0 ? 'true' : 'false'} title={lang.name}>
          {lang.label}
        </button>
      ))
    }
  </div>

  <div class="about">
    <picture class:list={['photo-frame', { 'has-wide': wide }]}>
      {wide && <source media="(min-width: 641px)" srcset={wide.srcSet.attribute} sizes="620px" type="image/webp" />}
      <Image class="photo" src={photo} alt={photoAlt} widths={[400, 800]} sizes="100vw" loading="eager" />
    </picture>

    {
      languages.map((lang, i) => (
        <section class="lang-text" lang={lang.code} data-lang-text={lang.code} hidden={i !== 0}>
          <h1 class="page-title">{lang.title}</h1>
          {paragraphs(lang.text).map((p) => (
            <p>{p}</p>
          ))}
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  const STORAGE_KEY = 'about-lang';

  function setLanguage(code: string) {
    document.querySelectorAll<HTMLElement>('[data-lang-text]').forEach((el) => {
      el.hidden = el.dataset.langText !== code;
    });
    document.querySelectorAll<HTMLButtonElement>('.lang-toggle button').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.lang === code));
    });
  }

  function initToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.lang-toggle button');
    if (!buttons.length) return; // not on the About page

    // Remember the choice for this visit (works without storage too).
    let saved: string | null = null;
    try {
      saved = sessionStorage.getItem(STORAGE_KEY);
    } catch {}
    if (saved === 'en' || saved === 'tr') setLanguage(saved);

    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const code = btn.dataset.lang ?? 'en';
        setLanguage(code);
        try {
          sessionStorage.setItem(STORAGE_KEY, code);
        } catch {}
      }),
    );
  }

  document.addEventListener('astro:page-load', initToggle);
</script>

<style>
  .lang-toggle {
    display: inline-flex;
    margin-bottom: 1.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .lang-toggle button {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0.45rem 1rem;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .lang-toggle button + button {
    border-left: 1px solid var(--border-strong);
  }
  .lang-toggle button[aria-pressed='true'] {
    background: var(--text);
    color: var(--bg);
  }
  .lang-toggle button:focus-visible {
    outline-offset: -3px;
  }

  /* Photo on top, text underneath */
  .about {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }
  .photo-frame {
    display: block;
  }
  .photo {
    width: 100%;
    aspect-ratio: 3 / 2; /* the landscape photo on computers */
    object-fit: cover;
    object-position: 30% 40%; /* keeps the face in view if the frame is cropped */
    border-radius: var(--radius);
  }
  /* no landscape photo given: show the portrait one beside the text, as before */
  .about:has(.photo-frame:not(.has-wide)) {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    align-items: start;
  }
  .photo-frame:not(.has-wide) .photo {
    aspect-ratio: 4 / 5;
  }
  .lang-text p {
    margin: 0 0 1.1rem;
  }
  /* Phones: the portrait photo, square, above the text (unchanged) */
  @media (max-width: 640px) {
    .about,
    .about:has(.photo-frame:not(.has-wide)) {
      display: flex;
      flex-direction: column;
    }
    .photo,
    .photo-frame:not(.has-wide) .photo {
      aspect-ratio: 1 / 1;
      object-position: center 30%;
    }
  }
</style>
