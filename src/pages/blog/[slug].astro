---
// Every blog post (/blog/<file-name>) is rendered through PostLayout.
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts(); // newest first
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post} newer={newer} older={older}>
  <Content />
</PostLayout>
