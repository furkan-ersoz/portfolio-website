---
// Blog index: the same card list as the Projects page (cover + title), newest first.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardList from '../../components/CardList.astro';
import { getSortedPosts, postToCard } from '../../lib/selected';

const items = (await getSortedPosts()).map(postToCard);
---

<BaseLayout title="Blog" description="Notes on music, pitch, perception and music technology.">
  <h1 class="page-title">Blog</h1>
  {items.length > 0 ? <CardList items={items} /> : <p class="muted">No posts yet.</p>}
</BaseLayout>
