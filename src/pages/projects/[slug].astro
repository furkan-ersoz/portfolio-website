---
// The template used for EVERY project page (/projects/<file-name>).
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudioCompare from '../../components/AudioCompare.astro';
import Audio from '../../components/Audio.astro';
import Video from '../../components/Video.astro';
import YouTube from '../../components/YouTube.astro';
import { getSortedProjects } from '../../lib/selected';
import { withBase, formatDate } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getSortedProjects(); // newest first
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: projects[i - 1], // the newer project
      next: projects[i + 1], // the older project
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// A link whose url is 'TODO' (or empty) is shown greyed out until you fill it in.
const isTodo = (url: string) => !url || url.trim().toUpperCase().startsWith('TODO');
---

<BaseLayout title={data.title} description={data.summary}>
  <article>
    <a class="back" href={withBase('/projects')}>← Projects</a>

    <header class="project-header">
      <p class="meta">
        <span>{data.category}</span>
        <span aria-hidden="true">·</span>
        <time datetime={data.date.toISOString()}>{formatDate(data.date, data.dateLabel)}</time>
        {data.status && <span class="badge">{data.status}</span>}
      </p>
      <h1>{data.title}</h1>
    </header>

    <Image
      class="hero-image"
      src={data.cover}
      alt={data.coverAlt ?? `Cover image for ${data.title}`}
      widths={[600, 900, 1400]}
      sizes="(max-width: 620px) 100vw, 620px"
      loading="eager"
    />

    {
      data.tags.length > 0 && (
        <ul class="tag-list tags" aria-label="Tags">
          {data.tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }

    {
      data.links.length > 0 && (
        <ul class="links">
          {data.links.map((link) => (
            <li>
              {isTodo(link.url) ? (
                <span class="button" aria-disabled="true" title="Coming soon">
                  {link.label}
                </span>
              ) : (
                <a class="button" href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.label} ↗
                </a>
              )}
            </li>
          ))}
        </ul>
      )
    }

    <div class="prose">
      <Content components={{ AudioCompare, Audio, Video, YouTube }} />
    </div>
  </article>

  <nav class="pager" aria-label="More projects">
    {
      prev && (
        <a class="pager-link" href={withBase(`/projects/${prev.id}`)}>
          <span class="muted">← Previous</span>
          <span>{prev.data.title}</span>
        </a>
      )
    }
    {
      next && (
        <a class="pager-link next" href={withBase(`/projects/${next.id}`)}>
          <span class="muted">Next →</span>
          <span>{next.data.title}</span>
        </a>
      )
    }
  </nav>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .back:hover {
    color: var(--text);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .meta .badge {
    text-transform: none;
    letter-spacing: 0;
  }
  h1 {
    font-size: clamp(1.4rem, 4.5vw, 1.8rem);
    letter-spacing: -0.02em;
  }

  .hero-image {
    width: 100%;
    margin-top: 1.75rem;
    border-radius: var(--radius);
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .tags {
    margin-top: 1.25rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
  }

  /* ── Typography for the MDX body ── */
  .prose {
    margin-top: 2.5rem;
  }
  .prose :global(h2) {
    font-size: 1.25rem;
    margin: 2.5rem 0 0.75rem;
  }
  .prose :global(h3) {
    font-size: 1.1rem;
    margin: 2rem 0 0.5rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1rem;
  }
  .prose :global(li) {
    margin-bottom: 0.35rem;
  }
  .prose :global(li::marker) {
    color: var(--text-muted);
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--border-strong);
    color: var(--text-muted);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--surface-hover);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .prose :global(img),
  .prose :global(video),
  .prose :global(iframe) {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 1.5rem 0 0.5rem;
    border: 0;
    border-radius: var(--radius);
  }
  .prose :global(iframe) {
    aspect-ratio: 16 / 9;
    height: auto;
  }
  .prose :global(figure) {
    margin: 1.5rem 0;
  }
  .prose :global(figcaption),
  .prose :global(.caption) {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .prose :global(audio) {
    width: 100%;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }
  /* a grid of big numbers (e.g. "400+ members") */
  .prose :global(.stats) {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
    margin: 1.5rem 0;
  }
  .prose :global(.stats > div) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 0.85rem;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .prose :global(.stats strong) {
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--text);
  }
  .prose :global(.stats span) {
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--text-muted);
  }
  @media (max-width: 640px) {
    .prose :global(.stats) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* tall, narrow images (e.g. a phone or email screenshot): centred, not full width */
  .prose :global(.figure-narrow) {
    max-width: 440px;
    margin: 1.5rem auto;
  }
  .prose :global(.figure-narrow img) {
    margin-top: 0;
  }
  .prose :global(.figure-narrow .caption) {
    text-align: center;
  }
  .prose :global(table) {
    display: block; /* lets a wide table scroll sideways on phones */
    overflow-x: auto;
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 0.45rem 0.75rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
    white-space: nowrap;
  }
  .prose :global(th) {
    font-weight: 600;
    color: var(--text-muted);
    border-bottom-color: var(--border-strong);
  }
  .prose > :global(:first-child) {
    margin-top: 0;
  }

  /* ── Previous / next ── */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .pager-link:hover {
    border-color: var(--border-strong);
    background: var(--surface);
  }
  .pager-link .muted {
    font-size: 0.85rem;
  }
  .pager-link.next {
    text-align: right;
    grid-column: 2;
  }
  @media (max-width: 640px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager-link.next {
      grid-column: auto;
    }
  }
</style>
