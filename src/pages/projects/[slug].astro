---
// Every project page (/projects/<file-name>). The page itself lives in src/layouts/EntryLayout.astro.
import { render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import AudioCompare from '../../components/AudioCompare.astro';
import Audio from '../../components/Audio.astro';
import Video from '../../components/Video.astro';
import YouTube from '../../components/YouTube.astro';
import { getSortedProjects } from '../../lib/selected';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getSortedProjects(); // newest first
  const link = (e?: (typeof projects)[number]) => e && { href: withBase(`/projects/${e.id}`), title: e.data.title };
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: link(projects[i - 1]), next: link(projects[i + 1]) },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout data={entry.data} back={{ href: withBase('/projects'), label: 'Projects' }} prev={prev} next={next} pagerLabel="More projects">
  <Content components={{ AudioCompare, Audio, Video, YouTube }} />
</EntryLayout>
