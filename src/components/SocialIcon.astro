---
// Small brand icons for the Contact and Listen pages.
import {
  siApplemusic,
  siBandcamp,
  siDeezer,
  siGithub,
  siInstagram,
  siSoundcloud,
  siSpotify,
  siYoutube,
  siYoutubemusic,
} from 'simple-icons';

interface Props {
  name:
    | 'linkedin'
    | 'github'
    | 'instagram'
    | 'youtube'
    | 'spotify'
    | 'soundcloud'
    | 'applemusic'
    | 'youtubemusic'
    | 'bandcamp'
    | 'deezer'
    | 'email';
  size?: number;
}

// LinkedIn isn't in simple-icons, so its shape is drawn here.
const linkedin =
  'M22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0zM7.12 20.45H3.56V9h3.56v11.45zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28z';

const paths: Record<Exclude<Props['name'], 'email'>, string> = {
  linkedin,
  github: siGithub.path,
  instagram: siInstagram.path,
  youtube: siYoutube.path,
  spotify: siSpotify.path,
  soundcloud: siSoundcloud.path,
  applemusic: siApplemusic.path,
  youtubemusic: siYoutubemusic.path,
  bandcamp: siBandcamp.path,
  deezer: siDeezer.path,
};

const { name, size = 18 } = Astro.props;
---

{
  name === 'email' ? (
    <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
      <path d="M3 6l9 7 9-7" />
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="currentColor" fill-rule="evenodd">
      <path d={paths[name]} />
    </svg>
  )
}
