---
// The small sound panel in the bottom-right corner (on every page, computers only).
// Two knobs (Tone, Space) and a Volume fader.
// Phones/tablets (touch-only screens) get no panel and no sound at all.
// In narrow browser windows it collapses into a round button.
// The sound itself: src/scripts/music.js
import Knob from './Knob.astro';
import Fader from './Fader.astro';
---

<aside class="music" aria-label="Background sound" transition:persist="music-panel">
  <!-- shown until the first click/tap (browsers don't allow sound before that) -->
  <p class="hint" aria-live="polite">Click anywhere for sound</p>
  <button class="music-toggle" type="button" aria-expanded="false" aria-controls="music-controls" aria-label="Sound controls">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
      <path d="M9 17.5V5l11-2v12.5a2.5 2.5 0 1 1-1.6-2.33V6.9L10.6 8.3v9.2A2.5 2.5 0 1 1 9 15.17z"></path>
    </svg>
  </button>

  <div class="controls" id="music-controls">
    <Knob name="tone" />
    <Knob name="space" />
    <Fader />
  </div>
</aside>

<script>
  import { CONTROLS } from '../../scripts/music-controls.js';

  type Name = keyof typeof CONTROLS;
  const panel = document.querySelector<HTMLElement>('.music');
  // Phones and tablets: no sound. The sound engine isn't even downloaded there.
  const touchOnly = window.matchMedia('(hover: none) and (pointer: coarse)').matches;

  if (panel && !touchOnly) {
    const { state, setControl, onStatusChange } = await import('../../scripts/music.js');

    // Using the panel shouldn't count as a click/hold on the page (sparkles, sound).
    panel.addEventListener('pointerdown', (e) => e.stopPropagation());

    // ── Phones: open / close the panel ──
    const opener = panel.querySelector<HTMLButtonElement>('.music-toggle')!;
    opener.addEventListener('click', () => {
      const open = panel.toggleAttribute('data-open');
      opener.setAttribute('aria-expanded', String(open));
    });

    // Sound on/off indicator (the round phone button turns red) + the "click for sound" hint
    onStatusChange(({ playing, waiting }) => {
      panel.toggleAttribute('data-playing', playing);
      panel.toggleAttribute('data-waiting', waiting);
    });

    // Value labels: shown while adjusting, hidden again shortly after.
    const hideTimers = new WeakMap<HTMLElement, number>();
    function showValue(el: HTMLElement, hideAfter = 900) {
      el.setAttribute('data-active', '');
      clearTimeout(hideTimers.get(el));
      if (hideAfter > 0) hideTimers.set(el, window.setTimeout(() => el.removeAttribute('data-active'), hideAfter));
    }

    // ── Knobs and fader ──
    const controls = panel.querySelectorAll<HTMLElement>('[data-control]');

    function render(el: HTMLElement) {
      const name = el.dataset.control as Name;
      const c = CONTROLS[name];
      const value = state[name];
      const pct = (value - c.min) / (c.max - c.min);
      el.setAttribute('aria-valuenow', String(Math.round(value * 100) / 100));
      el.setAttribute('aria-valuetext', c.format(value));
      el.querySelector('.readout')!.textContent = `${c.label} ${c.format(value)}`;
      if (el.classList.contains('knob')) {
        el.querySelector<SVGPathElement>('.value')!.style.strokeDasharray = `${pct * 100} 100`;
        el.querySelector<SVGGElement>('.pointer')!.style.transform = `rotate(${-135 + pct * 270}deg)`;
      } else {
        el.querySelector<HTMLElement>('.fill')!.style.height = `${pct * 100}%`;
        el.querySelector<HTMLElement>('.handle')!.style.bottom = `${pct * 100}%`;
      }
    }

    function set(el: HTMLElement, value: number) {
      const name = el.dataset.control as Name;
      const c = CONTROLS[name];
      setControl(name, Math.round(value / c.step) * c.step);
      render(el);
      if (!el.hasAttribute('data-dragging')) showValue(el);
    }

    controls.forEach((el) => {
      const name = el.dataset.control as Name;
      const c = CONTROLS[name];
      const range = c.max - c.min;
      const keyStep = Math.max(c.step, range / 50);
      const isFader = el.classList.contains('fader');
      render(el);

      // Drag: knobs follow vertical movement, the fader follows the pointer position.
      let startY = 0;
      let startValue = 0;
      const valueFromFader = (clientY: number) => {
        const box = el.querySelector('.track')!.getBoundingClientRect();
        return c.min + (1 - (clientY - box.top) / box.height) * range;
      };
      el.addEventListener('pointerdown', (e) => {
        el.setPointerCapture(e.pointerId);
        el.setAttribute('data-dragging', '');
        showValue(el, 0); // stays visible while dragging
        startY = e.clientY;
        startValue = state[name];
        if (isFader) set(el, valueFromFader(e.clientY));
      });
      el.addEventListener('pointermove', (e) => {
        if (!el.hasPointerCapture(e.pointerId)) return;
        if (isFader) return set(el, valueFromFader(e.clientY));
        const sensitivity = e.shiftKey ? 600 : 150; // px for the full range (Shift = fine)
        set(el, startValue + ((startY - e.clientY) / sensitivity) * range);
      });
      const end = () => {
        el.removeAttribute('data-dragging');
        showValue(el, 600);
      };
      el.addEventListener('pointerup', end);
      el.addEventListener('pointercancel', end);
      el.addEventListener('lostpointercapture', end);

      // Scroll wheel: one mouse-wheel notch ≈ 5%, trackpads move in smaller steps
      el.addEventListener(
        'wheel',
        (e) => {
          e.preventDefault();
          const notches = Math.max(-3, Math.min(3, e.deltaY / 100));
          set(el, state[name] - notches * keyStep * 2.5);
        },
        { passive: false },
      );

      // Double-click: back to the default
      el.addEventListener('dblclick', () => set(el, c.default));

      // Keyboard
      el.addEventListener('keydown', (e) => {
        const steps: Record<string, number> = {
          ArrowUp: keyStep,
          ArrowRight: keyStep,
          ArrowDown: -keyStep,
          ArrowLeft: -keyStep,
          PageUp: keyStep * 10,
          PageDown: -keyStep * 10,
        };
        if (e.key in steps) set(el, state[name] + steps[e.key]);
        else if (e.key === 'Home') set(el, c.min);
        else if (e.key === 'End') set(el, c.max);
        else return;
        e.preventDefault();
      });
    });
  }
</script>

<style>
  .music {
    --music-red: #ff3b2f;
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 20;
    text-shadow: none;
    font-size: 0.8rem;
  }

  /* "Click anywhere for sound" */
  .hint {
    display: none;
    margin: 0 0 6px;
    padding: 4px 8px;
    width: max-content;
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--text);
    background: #000;
    border: 1px solid var(--music-red);
  }
  .music[data-waiting] .hint {
    display: block;
  }

  /* Phones and tablets: no sound panel */
  @media (hover: none) and (pointer: coarse) {
    .music {
      display: none;
    }
  }

  .controls {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    padding: 12px 14px 10px;
    background: #000;
    border: 1px solid var(--border-strong);
  }

  button {
    appearance: none;
    font: inherit;
    color: var(--text);
    background: #000;
    border: 1px solid var(--border-strong);
    cursor: pointer;
  }
  button:hover {
    border-color: var(--text);
  }

  /* The round button only exists on phones */
  .music-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    place-items: center;
  }

  @media (max-width: 760px) {
    .music {
      right: 12px;
      bottom: 12px;
    }
    .music-toggle {
      display: grid;
      margin-left: auto;
    }
    .hint {
      position: absolute;
      right: 54px;
      bottom: 10px;
      margin: 0;
    }
    .music[data-playing] .music-toggle {
      border-color: var(--music-red);
      color: var(--music-red);
    }
    .controls {
      display: none;
      position: absolute;
      right: 0;
      bottom: 54px;
    }
    .music[data-open] .controls {
      display: flex;
    }
  }
</style>
