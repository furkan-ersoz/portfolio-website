---
// One card: the framed cover image with the title underneath.
// The whole card is a link. Used on the homepage and the Projects page.
import { Image } from 'astro:assets';
import type { CardItem } from '../lib/selected';

interface Props {
  item: CardItem;
}

const { item } = Astro.props;
---

<a class="card" href={item.href}>
  <div class="frame">
    <Image
      class="cover"
      src={item.cover}
      alt={item.coverAlt}
      widths={[600, 900, 1400]}
      sizes="(max-width: 900px) 100vw, 900px"
      loading="lazy"
      decoding="async"
    />
  </div>
  <h3 class="title">{item.title}</h3>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* The frame around the picture */
  .frame {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: #111;
    transition: border-color 0.35s;
  }
  .card:hover .frame,
  .card:focus-visible .frame {
    border-color: var(--text);
  }

  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Black & white by default … */
    filter: grayscale(1);
    transition: filter 0.35s ease;
  }
  /* … colour on hover / keyboard focus */
  .card:hover .cover,
  .card:focus-visible .cover {
    filter: grayscale(0);
  }
  /* Touch screens (no hover): colour when scrolled into view — only one at a time (see CardList.astro) */
  @media (hover: none) {
    :global(.card.in-view) .cover {
      filter: grayscale(0);
    }
  }

  .title {
    margin-top: 0.75rem;
    font-size: clamp(1.05rem, 2.6vw, 1.3rem);
    font-weight: 600;
  }
</style>
