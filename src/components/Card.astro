---
// One wide, horizontal card: cover image on the left, text on the right.
// The whole card is a link. Used on the homepage and the Projects page.
import { Image } from 'astro:assets';
import type { CardItem } from '../lib/selected';
import { formatDate } from '../lib/url';

interface Props {
  item: CardItem;
}

const { item } = Astro.props;
---

<a class="card" href={item.href}>
  <div class="cover-wrap">
    <Image
      class="cover"
      src={item.cover}
      alt={item.coverAlt}
      widths={[400, 700]}
      sizes="(max-width: 640px) 100vw, 340px"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="body">
    <p class="meta">
      <span>{item.category}</span>
      <span aria-hidden="true">·</span>
      <time datetime={item.date.toISOString()}>{formatDate(item.date, item.dateLabel)}</time>
    </p>
    <h3 class="title">{item.title}</h3>
    <p class="summary">{item.summary}</p>
    {
      item.tags.length > 0 && (
        <ul class="tag-list" aria-label="Tags">
          {item.tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-columns: minmax(0, 38%) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 1.75rem);
    padding: clamp(0.75rem, 2vw, 1rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.3s var(--ease),
      border-color 0.3s,
      background 0.3s;
  }
  .card:hover,
  .card:focus-visible {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    background: var(--surface-hover);
  }

  .cover-wrap {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: calc(var(--radius) - 4px);
    background: #111;
  }
  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Black & white by default … */
    filter: grayscale(1);
    transition: filter 0.35s ease;
  }
  /* … colour on hover / keyboard focus */
  .card:hover .cover,
  .card:focus-visible .cover {
    filter: grayscale(0);
  }
  /* Touch screens (no hover): colour when scrolled into view (see CardList.astro) */
  @media (hover: none) {
    :global(.card.in-view) .cover {
      filter: grayscale(0);
    }
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    align-self: center;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .title {
    font-size: clamp(1.1rem, 2.6vw, 1.35rem);
  }
  .summary {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .tag-list {
    margin-top: 0.25rem;
  }

  @media (max-width: 640px) {
    .card {
      grid-template-columns: 1fr;
    }
  }
</style>
