---
// Embeds a YouTube video in MDX:  <YouTube id="dQw4w9WgXcQ" title="Demo video" />
// The id is the part after "watch?v=" in the YouTube link.
interface Props {
  id: string;
  title?: string;
}
const { id, title = 'YouTube video' } = Astro.props;
---

<figure>
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${id}`}
    title={title}
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen></iframe>
</figure>
