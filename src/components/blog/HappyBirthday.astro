---
// Listen: Happy Birthday (public domain) in 12-TET and in Rast (53-grid), in three registers.
import { HAPPY_BIRTHDAY, HB_RAST, HB_TURKISH, HB_WESTERN } from '../../lib/tuning';

const BEAT_MS = 600; // 100 BPM
const melody = HAPPY_BIRTHDAY.map(([note, octave, beats]) => ({
  note,
  turkish: HB_TURKISH[`${note}${octave}`],
  ms: beats * BEAT_MS,
  western: octave * 1200 + HB_WESTERN[note],
  rast: octave * 1200 + HB_RAST[note],
}));
const REGISTERS = [
  { hz: 392, label: 'G4 = 392 Hz' },
  { hz: 196, label: 'G3 = 196 Hz' },
  { hz: 98, label: 'G2 = 98 Hz' },
];
---

<figure class="hb" data-melody={JSON.stringify(melody)}>
  <p class="hb-title">Happy Birthday in two tunings</p>

  <div class="hb-controls">
    <button type="button" class="button" data-play="western">▶ Play Western</button>
    <button type="button" class="button" data-play="rast">▶ Play Rast</button>
    <button type="button" class="button" data-play="ab">▶ A/B</button>
    <button type="button" class="button" data-play="stop">■ Stop</button>
  </div>

  <fieldset class="hb-register">
    <legend>Register (G):</legend>
    {
      REGISTERS.map((r, i) => (
        <label>
          <input type="radio" name="hb-register" value={r.hz} checked={i === 0} />
          {r.label}
        </label>
      ))
    }
  </fieldset>

  <p class="hb-names" aria-hidden="true">Note names: <span class="hb-names-mode">Western</span></p>
  <ol class="hb-notes" aria-hidden="true">
    {
      melody.map((n) => (
        <li class:list={{ moved: Math.abs(n.western - n.rast) > 10 }} data-western={n.note} data-turkish={n.turkish}>
          {n.note}
        </li>
      ))
    }
  </ol>
  <p class="hb-status" aria-live="polite">&nbsp;</p>

  <figcaption>
    Same melody, same rhythm (3/4, 100 BPM). Every Rast note sits on the 53 Holder koması grid; only Rast itself (G) is
    shared with 12-TET. Segâh (B) is 15.1 cents lower and Eviç (F♯) 13.2 cents lower (underlined); Dügâh, Çârgâh, Nevâ and
    Hüseynî are only 2–6 cents away, so you may not hear a difference there. While Rast plays, the notes show their Turkish
    names. Try the lower registers too: in Hz the same cents get smaller.
  </figcaption>
</figure>

<script>
  import { playSequence } from '../../scripts/play-note';

  interface Note {
    note: string;
    ms: number;
    western: number;
    rast: number;
  }

  function setup(fig: HTMLElement) {
    fig.dataset.ready = '';
    const melody: Note[] = JSON.parse(fig.dataset.melody || '[]');
    const chips = [...fig.querySelectorAll<HTMLElement>('.hb-notes li')];
    const status = fig.querySelector<HTMLElement>('.hb-status')!;
    let stop: (() => void) | null = null;

    const base = () => Number(fig.querySelector<HTMLInputElement>('input[name="hb-register"]:checked')?.value ?? 392);
    const mark = (i: number) => chips.forEach((c, j) => c.classList.toggle('now', j === i));
    const namesMode = fig.querySelector<HTMLElement>('.hb-names-mode')!;
    let names: 'western' | 'rast' = 'western';
    // Western letters for 12-TET, Turkish (AEU) names for Rast
    function showNames(tuning: 'western' | 'rast') {
      if (tuning === names) return;
      names = tuning;
      chips.forEach((c) => (c.textContent = tuning === 'rast' ? c.dataset.turkish! : c.dataset.western!));
      namesMode.textContent = tuning === 'rast' ? 'Turkish (Rast = G)' : 'Western';
    }

    function sequence(tuning: 'western' | 'rast') {
      const g = base();
      return melody.map((n) => ({ freq: g * 2 ** (n[tuning] / 1200), ms: n.ms, gate: 0.95 }));
    }

    function play(mode: string) {
      stop?.();
      stop = null;
      mark(-1);
      if (mode === 'stop') {
        status.textContent = ' ';
        return;
      }
      const rest = { freq: 0, ms: 1200 };
      const parts: ('western' | 'rast')[] = mode === 'ab' ? ['western', 'rast'] : [mode as 'western' | 'rast'];
      const notes = parts.flatMap((p, i) => (i ? [rest, ...sequence(p)] : sequence(p)));
      const n = melody.length;
      showNames(parts[0]);
      stop = playSequence(notes, {
        onStep: (i) => {
          // which part are we in? (A/B has a rest between the two)
          const inB = mode === 'ab' && i > n;
          const idx = inB ? i - n - 1 : i;
          if (idx < 0 || idx >= n) return mark(-1);
          const part = mode === 'ab' ? (inB ? 'rast' : 'western') : (mode as 'western' | 'rast');
          showNames(part);
          status.textContent = `Playing: ${part === 'rast' ? 'Rast (53-grid)' : 'Western (12-TET)'} · G = ${base()} Hz`;
          mark(idx);
        },
        onEnd: () => {
          mark(-1);
          status.textContent = ' ';
        },
      });
      if (!stop) status.textContent = 'Sound is off. Turn up Vol in the sound panel (bottom-right).';
    }

    fig.querySelectorAll<HTMLButtonElement>('[data-play]').forEach((btn) =>
      btn.addEventListener('click', () => play(btn.dataset.play!)),
    );
  }

  const init = () => document.querySelectorAll<HTMLElement>('.hb:not([data-ready])').forEach(setup);
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .hb {
    --c-surface: #111111;
    --c-ink: #f2f2f2;
    --c-ink-2: #cfcfcf;
    --c-accent: #d95926; /* orange: notes that move in Rast */
    margin: 2rem 0;
    padding: 1rem;
    background: var(--c-surface);
    border: 1px solid var(--border-strong);
    font-size: 0.9rem;
    text-shadow: none;
  }
  .hb-names {
    margin: 0.9rem 0 0;
    font-size: 0.8rem;
    color: var(--c-ink-2);
  }
  .hb-names-mode {
    color: var(--c-ink);
    font-weight: 600;
  }
  .hb-title {
    margin: 0 0 0.75rem;
    font-weight: 600;
  }
  .hb-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .hb-controls .button {
    font: inherit;
    font-size: 0.85rem;
    color: var(--text);
    cursor: pointer;
    padding: 0.45em 0.8em;
  }
  .hb-register {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0.85rem 0 0;
    padding: 0;
    border: 0;
    color: var(--c-ink-2);
    font-size: 0.85rem;
  }
  .hb-register legend {
    float: left;
    padding: 0;
    margin-right: 0.25rem;
  }
  .hb-register label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    color: var(--text);
  }
  .hb-register input {
    accent-color: var(--text);
    margin: 0;
  }
  .hb-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .hb-notes li {
    min-width: 2.1em;
    padding: 0.15em 0.3em;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--c-ink);
  }
  .hb-notes li.moved {
    text-decoration: underline;
    text-decoration-color: var(--c-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .hb-notes li.now {
    color: var(--bg);
    background: var(--text);
    border-color: var(--text);
    text-shadow: none;
  }
  .hb-status {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--c-ink-2);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--c-ink-2);
  }
</style>
